@prefix : <http://coconutKG.aksw.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://coconutKG.aksw.org/ontology#> .

<http://coconutKG.aksw.org/ontology#> rdf:type owl:Ontology ;
                                       <http://purl.org/dc/terms/creator> "Louis Westerheide" ;
                                       <http://purl.org/dc/terms/description> "COCONUT[KG] is a knowledge graph based on the Coconut Dataset, which is a comprehensive platform that facilitates natural product research by providing data, tools, and other resources and provides services for the deposition, curation, and reuse of data."@en ;
                                       <http://purl.org/dc/terms/rights> ""@en ;
                                       <http://purl.org/dc/terms/title> "COCONUT[KG]"@en ;
                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "coco" ;
                                       <http://purl.org/vocab/vann/preferredNamespaceUri> "http://coconutKG.aksw.org/ontology#" ;
                                       rdfs:label "coco: CoconutKG"@en ;
                                       owl:versionInfo "SNAPSHOT" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/rights
<http://purl.org/dc/terms/rights> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://coconutKG.aksw.org/ontology#citedIn
:citedIn rdf:type owl:ObjectProperty ;
         rdfs:domain :Entry ;
         rdfs:range :Citation ;
         rdfs:comment "The entry and its corresponding citation."@en ;
         rdfs:label "citedIn"@en .


###  http://coconutKG.aksw.org/ontology#classifiedBy
:classifiedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :Molecule ;
              rdfs:range :Classification ;
              rdfs:comment "A molecule is classified by its classification."@en ;
              rdfs:label "classifiedBy"@en .


###  http://coconutKG.aksw.org/ontology#contains
:contains rdf:type owl:ObjectProperty ;
          rdfs:domain :Entry ;
          rdfs:range :Molecule ;
          rdfs:comment "An entry contains a given molecule."@en ;
          rdfs:label "contains"@en .


###  http://coconutKG.aksw.org/ontology#defines
:defines rdf:type owl:ObjectProperty ;
         rdfs:domain :Descriptor ;
         rdfs:range :Properties ;
         rdfs:comment ""@en ;
         rdfs:label "defines"@en .


###  http://coconutKG.aksw.org/ontology#derivedFrom
:derivedFrom rdf:type owl:ObjectProperty ;
             rdfs:domain :Entry ;
             rdfs:range :Organism ;
             rdfs:comment ""@en ;
             rdfs:label "derivedFrom"@en .


###  http://coconutKG.aksw.org/ontology#describedBy
:describedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Molecule ;
             rdfs:range :Properties ;
             rdfs:comment "A molecule is descriped by its properties."@en ;
             rdfs:label "describedBy"@en .


###  http://coconutKG.aksw.org/ontology#foundIn
:foundIn rdf:type owl:ObjectProperty ;
         rdfs:domain :Molecule ;
         rdfs:range :GeoLocation ;
         rdfs:comment "A molecule is found in a geo location."@en ;
         rdfs:label "foundIn"@en .


###  http://coconutKG.aksw.org/ontology#hasAmounts
:hasAmounts rdf:type owl:ObjectProperty ;
            rdfs:domain :Molecule ;
            rdfs:range :Counts ;
            rdfs:comment "A molecule has certain amounts of different countable properties."@en ;
            rdfs:label "hasAmounts"@en .


###  http://coconutKG.aksw.org/ontology#hasStatus
:hasStatus rdf:type owl:ObjectProperty ;
           rdfs:domain :Molecule ;
           rdfs:range :Status ;
           rdfs:comment "A molecule has various statuses."@en ;
           rdfs:label "hasStatus"@en .


###  http://coconutKG.aksw.org/ontology#includes
:includes rdf:type owl:ObjectProperty ;
          rdfs:domain :Collection ;
          rdfs:range :Molecule ;
          rdfs:comment "The collection includes a molecule."@en ;
          rdfs:label "includes"@en .


###  http://coconutKG.aksw.org/ontology#isExplainedThrough
:isExplainedThrough rdf:type owl:ObjectProperty ;
                    rdfs:domain :Molecule ;
                    rdfs:range :DescriptiveInformation ;
                    rdfs:comment "A molecule is explained through its descriptive information."@en ;
                    rdfs:label "isExplainedThrough"@en .


###  http://coconutKG.aksw.org/ontology#isRepresentedIn
:isRepresentedIn rdf:type owl:ObjectProperty ;
                 rdfs:domain :Collection ;
                 rdfs:range :Entry ;
                 rdfs:comment "A collection is represented in an entry."@en ;
                 rdfs:label "isRepresentedIn"@en .


###  http://coconutKG.aksw.org/ontology#labeledBy
:labeledBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Molecule ;
           rdfs:range :Identifier ;
           rdfs:comment "A molceule is labeled by an Identifier."@en ;
           rdfs:label "labeledBy"@en .


###  http://coconutKG.aksw.org/ontology#locatedIn
:locatedIn rdf:type owl:ObjectProperty ;
           rdfs:domain :Entry ;
           rdfs:range :GeoLocation ;
           rdfs:comment ""@en ;
           rdfs:label "locatedIn"@en .


###  http://coconutKG.aksw.org/ontology#originatesFrom
:originatesFrom rdf:type owl:ObjectProperty ;
                rdfs:domain :Molecule ;
                rdfs:range :Organism ;
                rdfs:comment "The molecule origintes from a certain organism."@en ;
                rdfs:label "originatesFrom"@en .


###  http://coconutKG.aksw.org/ontology#specifiesExtractionLocationOf
:specifiesExtractionLocationOf rdf:type owl:ObjectProperty ;
                               rdfs:domain :SampleLocation ;
                               rdfs:range :Molecule ;
                               rdfs:comment "The sample location specifies from where the molecule was extracted from."@en ;
                               rdfs:label "specifiesExtractionLocationOf"@en .


###  http://coconutKG.aksw.org/ontology#specifiesLocationOf
:specifiesLocationOf rdf:type owl:ObjectProperty ;
                     rdfs:domain :SampleLocation ;
                     rdfs:range :Organism ;
                     rdfs:comment "The sample location specifies the location of the organism it originated from."@en ;
                     rdfs:label "specifiesLocationOf"@en .


#################################################################
#    Data properties
#################################################################

###  http://coconutKG.aksw.org/ontology#AlogP
:AlogP rdf:type owl:DatatypeProperty ;
       rdfs:domain :ElectronicDescriptor ;
       rdfs:range xsd:decimal ;
       rdfs:comment "The logarithm of the partition between n-octanol and water (logP). AlogP is used to estimate the lipophilicity of a molecule, which is an important factor in drug absorption and distribution."@en ;
       rdfs:label "AlogP"@en .


###  http://coconutKG.aksw.org/ontology#LipinskiRuleOfFiveViolations
:LipinskiRuleOfFiveViolations rdf:type owl:DatatypeProperty ;
                              rdfs:domain :ElectronicDescriptor ;
                              rdfs:range xsd:int ;
                              rdfs:comment "A custom function to determine the number of Lipinski's rule violations for a given molecule."@en ;
                              rdfs:label "Lipinski Rule Of Five Violations"@en .


###  http://coconutKG.aksw.org/ontology#active
:active rdf:type owl:DatatypeProperty ;
        rdfs:domain :Status ;
        rdfs:range xsd:boolean ;
        rdfs:comment "Indicates whether the molecule is currently active or inactive."@en ;
        rdfs:label "Active"@en .


###  http://coconutKG.aksw.org/ontology#activeCitation
:activeCitation rdf:type owl:DatatypeProperty ;
                rdfs:domain :Citation ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Determines wheater a citation is still active or not."@en ;
                rdfs:label "Active Citation"@en .


###  http://coconutKG.aksw.org/ontology#annotationLevel
:annotationLevel rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DescriptiveInformation ;
                 rdfs:range xsd:int ;
                 rdfs:comment "A numerical value indicating the thoroughness or depth of the annotation provided for the molecule, reflecting its level of detail."@en ;
                 rdfs:label "Annotation Level"@en .


###  http://coconutKG.aksw.org/ontology#aromaticRingCount
:aromaticRingCount rdf:type owl:DatatypeProperty ;
                   rdfs:domain :TopologicalDescriptor ;
                   rdfs:range xsd:int ;
                   rdfs:comment "The number of aromatic rings in a molecule."@en ;
                   rdfs:label "Aromatic Ring Count"@en .


###  http://coconutKG.aksw.org/ontology#authors
:authors rdf:type owl:DatatypeProperty ;
         rdfs:domain :Citation ;
         rdfs:range xsd:string ;
         rdfs:comment "The names of the authors of the citation."@en ;
         rdfs:label "Authors"@en .


###  http://coconutKG.aksw.org/ontology#canonicalSmiles
:canonicalSmiles rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Identifier ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The canonical Simplified Molecular Input Line Entry System (SMILES) notation for the molecule, representing its structure in a line of text."@en ;
                 rdfs:label "Canonical Smiles"@en .


###  http://coconutKG.aksw.org/ontology#chemicalClass
:chemicalClass rdf:type owl:DatatypeProperty ;
               rdfs:domain :ConstitutionalDescriptor ;
               rdfs:range xsd:string ;
               rdfs:comment "Chemical Class generated using ClassyFire."@en ;
               rdfs:label "Chemical Class"@en .


###  http://coconutKG.aksw.org/ontology#chemicalSubClass
:chemicalSubClass rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ConstitutionalDescriptor ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Chemical Sub Class generated using ClassyFire."@en ;
                  rdfs:label "Chemical Sub Class"@en .


###  http://coconutKG.aksw.org/ontology#chemicalSuperClass
:chemicalSuperClass rdf:type owl:DatatypeProperty ;
                    rdfs:domain :ConstitutionalDescriptor ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Chemical Super Class generated using ClassyFire."@en ;
                    rdfs:label "Chemical Super Class"@en .


###  http://coconutKG.aksw.org/ontology#citationCount
:citationCount rdf:type owl:DatatypeProperty ;
               rdfs:domain :Counts ;
               rdfs:range xsd:int ;
               rdfs:comment "The number of times the molecule has been cited in literature or other references."@en ;
               rdfs:label "Citation Count"@en .


###  http://coconutKG.aksw.org/ontology#citationDoi
:citationDoi rdf:type owl:DatatypeProperty ;
             rdfs:domain :Citation ;
             rdfs:range xsd:string ;
             rdfs:comment "The DOI (Digital Object Identifier) of the citation."@en ;
             rdfs:label "Citation DOI"@en .


###  http://coconutKG.aksw.org/ontology#citationTitle
:citationTitle rdf:type owl:DatatypeProperty ;
               rdfs:domain :Citation ;
               rdfs:range xsd:string ;
               rdfs:comment "The title of the citation."@en ;
               rdfs:label "Citation Title"@en .


###  http://coconutKG.aksw.org/ontology#collectionCount
:collectionCount rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Counts ;
                 rdfs:range xsd:int ;
                 rdfs:comment "The total number of collections in which the molecule is included."@en ;
                 rdfs:label "Collection Count"@en .


###  http://coconutKG.aksw.org/ontology#collectionDoi
:collectionDoi rdf:type owl:DatatypeProperty ;
               rdfs:domain :Collection ;
               rdfs:range xsd:string ;
               rdfs:comment "The Digital Object Identifier (DOI) assigned to the collection."@en ;
               rdfs:label "Collection DOI"@en .


###  http://coconutKG.aksw.org/ontology#collectionIdentifier
:collectionIdentifier rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Collection ;
                      rdfs:range xsd:string ;
                      rdfs:comment "The identifier of the collection."@en ;
                      rdfs:label "Identifier"@en .


###  http://coconutKG.aksw.org/ontology#collectionSlug
:collectionSlug rdf:type owl:DatatypeProperty ;
                rdfs:domain :Collection ;
                rdfs:range xsd:string ;
                rdfs:comment "A user- and search engine-friendly text consisting of one or a few words as part of a URL"@en ;
                rdfs:label "Collection Slug"@en .


###  http://coconutKG.aksw.org/ontology#collectionTitle
:collectionTitle rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Collection ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The title of the collection."@en ;
                 rdfs:label "Collection Title"@en .


###  http://coconutKG.aksw.org/ontology#comment
:comment rdf:type owl:DatatypeProperty ;
         rdfs:domain :DescriptiveInformation ;
         rdfs:range xsd:string ;
         rdfs:comment "General remarks or additional notes regarding the molecule."@en ;
         rdfs:label "Comment"@en .


###  http://coconutKG.aksw.org/ontology#comments
:comments rdf:type owl:DatatypeProperty ;
          rdfs:domain :Collection ;
          rdfs:range xsd:string ;
          rdfs:comment "Additional remarks or notes about the collection that might provide further context or insight."@en ;
          rdfs:label "Comments"@en .


###  http://coconutKG.aksw.org/ontology#containsLinearSugars
:containsLinearSugars rdf:type owl:DatatypeProperty ;
                      rdfs:domain :TopologicalDescriptor ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Utilizing the Sugar Removal Utility to check for the presence of linear sugars."@en ;
                      rdfs:label "Contains Linear Sugars"@en .


###  http://coconutKG.aksw.org/ontology#containsRingSugars
:containsRingSugars rdf:type owl:DatatypeProperty ;
                    rdfs:domain :TopologicalDescriptor ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Utilizing the Sugar Removal Utility to check for the presence of circular sugars."@en ;
                    rdfs:label "Contains Ring Sugars"@en .


###  http://coconutKG.aksw.org/ontology#containsSugar
:containsSugar rdf:type owl:DatatypeProperty ;
               rdfs:domain :TopologicalDescriptor ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Utilizing the Sugar Removal Utility to check for the presence of circular or linear sugars."@en ;
               rdfs:label "Contains Sugar"@en .


###  http://coconutKG.aksw.org/ontology#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:domain :Collection ;
             rdfs:range xsd:string ;
             rdfs:comment "The description of a given Collection."@en ;
             rdfs:label "Description"@en .


###  http://coconutKG.aksw.org/ontology#directParentClassification
:directParentClassification rdf:type owl:DatatypeProperty ;
                            rdfs:domain :ConstitutionalDescriptor ;
                            rdfs:range xsd:string ;
                            rdfs:comment "Direct Parent Classification generated using ClassyFire."@en ;
                            rdfs:label "Direct Parent Classification"@en .


###  http://coconutKG.aksw.org/ontology#entryCanonicalSmiles
:entryCanonicalSmiles rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Entry ;
                      rdfs:range xsd:string ;
                      rdfs:comment ""@en ;
                      rdfs:label "Entry Canonical Smiles"@en .


###  http://coconutKG.aksw.org/ontology#entryErrorCode
:entryErrorCode rdf:type owl:DatatypeProperty ;
                rdfs:domain :Entry ;
                rdfs:range xsd:int ;
                rdfs:comment ""@en ;
                rdfs:label "Entry Error Code"@en .


###  http://coconutKG.aksw.org/ontology#entryErrors
:entryErrors rdf:type owl:DatatypeProperty ;
             rdfs:domain :Entry ;
             rdfs:range xsd:string ;
             rdfs:comment ""@en ;
             rdfs:label "Entry Errors"@en .


###  http://coconutKG.aksw.org/ontology#entryHasStereocenters
:entryHasStereocenters rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Entry ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment ""@en ;
                       rdfs:label "Entry has stereocenters"@en .


###  http://coconutKG.aksw.org/ontology#entryIsInvalid
:entryIsInvalid rdf:type owl:DatatypeProperty ;
                rdfs:domain :Entry ;
                rdfs:range xsd:boolean ;
                rdfs:comment ""@en ;
                rdfs:label "Entry is invalid"@en .


###  http://coconutKG.aksw.org/ontology#entryLink
:entryLink rdf:type owl:DatatypeProperty ;
           rdfs:domain :Entry ;
           rdfs:range xsd:string ;
           rdfs:comment ""@en ;
           rdfs:label "Entry Link"@en .


###  http://coconutKG.aksw.org/ontology#entryMolecularFormula
:entryMolecularFormula rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Entry ;
                       rdfs:range xsd:string ;
                       rdfs:comment ""@en ;
                       rdfs:label "Entry Molecular Formula"@en .


###  http://coconutKG.aksw.org/ontology#entryName
:entryName rdf:type owl:DatatypeProperty ;
           rdfs:domain :Entry ;
           rdfs:range xsd:string ;
           rdfs:comment ""@en ;
           rdfs:label "Entry Name"@en .


###  http://coconutKG.aksw.org/ontology#entryOrganismPart
:entryOrganismPart rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Entry ;
                   rdfs:range xsd:string ;
                   rdfs:comment ""@en ;
                   rdfs:label "Entry Organism Part"@en .


###  http://coconutKG.aksw.org/ontology#entryParentCanonicalSmiles
:entryParentCanonicalSmiles rdf:type owl:DatatypeProperty ;
                            rdfs:domain :Entry ;
                            rdfs:range xsd:string ;
                            rdfs:comment ""@en ;
                            rdfs:label "Entry Parent Canonical Smiles"@en .


###  http://coconutKG.aksw.org/ontology#entryPreciseLocation
:entryPreciseLocation rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Entry ;
                      rdfs:range xsd:string ;
                      rdfs:comment ""@en ;
                      rdfs:label "Entry Precise Location"@en .


###  http://coconutKG.aksw.org/ontology#entryStandardizedCanonicalSmiles
:entryStandardizedCanonicalSmiles rdf:type owl:DatatypeProperty ;
                                  rdfs:domain :Entry ;
                                  rdfs:range xsd:string ;
                                  rdfs:comment ""@en ;
                                  rdfs:label "Entry Standardized Canonical Smiles"@en .


###  http://coconutKG.aksw.org/ontology#entryStatus
:entryStatus rdf:type owl:DatatypeProperty ;
             rdfs:domain :Entry ;
             rdfs:range xsd:string ;
             rdfs:comment ""@en ;
             rdfs:label "Entry Status"@en .


###  http://coconutKG.aksw.org/ontology#entryStructuralComments
:entryStructuralComments rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Entry ;
                         rdfs:range xsd:string ;
                         rdfs:comment ""@en ;
                         rdfs:label "Entry Structural Comments"@en .


###  http://coconutKG.aksw.org/ontology#exactMolecularWeight
:exactMolecularWeight rdf:type owl:DatatypeProperty ;
                      rdfs:domain :GeometricalDescriptor ;
                      rdfs:range xsd:decimal ;
                      rdfs:comment "The exact molecular weight of the molecule which is based on the isotope masses of the atoms in the molecule."@en ;
                      rdfs:label "Exact Molecular Weight"@en .


###  http://coconutKG.aksw.org/ontology#formalCharge
:formalCharge rdf:type owl:DatatypeProperty ;
              rdfs:domain :ElectronicDescriptor ;
              rdfs:range xsd:string ;
              rdfs:comment "The formal charge of the molecule."@en ;
              rdfs:label "Formal Charge"@en .


###  http://coconutKG.aksw.org/ontology#fractioncsp3
:fractioncsp3 rdf:type owl:DatatypeProperty ;
              rdfs:domain :ConstitutionalDescriptor ;
              rdfs:range xsd:decimal ;
              rdfs:comment "The fraction of C atoms that are SP3 hybridized."@en ;
              rdfs:label "Fraction CSP3"@en .


###  http://coconutKG.aksw.org/ontology#geoCount
:geoCount rdf:type owl:DatatypeProperty ;
          rdfs:domain :Counts ;
          rdfs:range xsd:int ;
          rdfs:comment "The count of geographical occurrences or representations related to the molecule."@en ;
          rdfs:label "Geo Count"@en .


###  http://coconutKG.aksw.org/ontology#hasStereo
:hasStereo rdf:type owl:DatatypeProperty ;
           rdfs:domain :Classification ;
           rdfs:range xsd:boolean ;
           rdfs:comment "Indicates whether the molecule has stereochemistry, which refers to the spatial arrangement of atoms in a molecule."@en ;
           rdfs:label "has Stereo"@en .


###  http://coconutKG.aksw.org/ontology#hasVariants
:hasVariants rdf:type owl:DatatypeProperty ;
             rdfs:domain :Classification ;
             rdfs:range xsd:boolean ;
             rdfs:comment "Indicates if there are alternative forms or variants of the entity."@en ;
             rdfs:label "has Variants"@en .


###  http://coconutKG.aksw.org/ontology#heavyAtomCount
:heavyAtomCount rdf:type owl:DatatypeProperty ;
                rdfs:domain :GeometricalDescriptor ;
                rdfs:range xsd:int ;
                rdfs:comment "Total count of the heavy atoms."@en ;
                rdfs:label "Heavy Atom Count"@en .


###  http://coconutKG.aksw.org/ontology#hydrogenBondAcceptors
:hydrogenBondAcceptors rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ElectronicDescriptor ;
                       rdfs:range xsd:int ;
                       rdfs:comment "The number of Hydrogen Bond Acceptors in a molecule."@en ;
                       rdfs:label "Hydrogen Bond Acceptors"@en .


###  http://coconutKG.aksw.org/ontology#hydrogenBondAcceptorsLipinski
:hydrogenBondAcceptorsLipinski rdf:type owl:DatatypeProperty ;
                               rdfs:domain :ElectronicDescriptor ;
                               rdfs:range xsd:int ;
                               rdfs:comment "Number of Hydrogen Bond Acceptors in a molecule using the Lipinski module."@en ;
                               rdfs:label "Hydrogen Bond Acceptors Lipinski"@en .


###  http://coconutKG.aksw.org/ontology#hydrogenBondDonors
:hydrogenBondDonors rdf:type owl:DatatypeProperty ;
                    rdfs:domain :ElectronicDescriptor ;
                    rdfs:range xsd:int ;
                    rdfs:comment "The number of Hydrogen Bond Donors in a molecule."@en ;
                    rdfs:label "Hydrogen Bond Donors"@en .


###  http://coconutKG.aksw.org/ontology#hydrogenBondDonorsLipinski
:hydrogenBondDonorsLipinski rdf:type owl:DatatypeProperty ;
                            rdfs:domain :ElectronicDescriptor ;
                            rdfs:range xsd:int ;
                            rdfs:comment "Number of Hydrogen Bond Donors in a molecule using the Lipinski module."@en ;
                            rdfs:label "Hydrogen Bond Donors Lipinski"@en .


###  http://coconutKG.aksw.org/ontology#image
:image rdf:type owl:DatatypeProperty ;
       rdfs:domain :Collection ;
       rdfs:range xsd:string ;
       rdfs:comment "An additional or alternative image related to the collection."@en ;
       rdfs:label "Image"@en .


###  http://coconutKG.aksw.org/ontology#iri
:iri rdf:type owl:DatatypeProperty ;
     rdfs:domain :Organism ;
     rdfs:range xsd:string ;
     rdfs:comment "The IRI (Internationalized Resource Identifier) is the internationalised version of the URI (Uniform Resource Identifier)"@en ;
     rdfs:label "IRI"@en .


###  http://coconutKG.aksw.org/ontology#isParent
:isParent rdf:type owl:DatatypeProperty ;
          rdfs:domain :Classification ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Indicates whether the molecule serves as a parent classification in a hierarchical relationship, meaning it has child entities or variants."@en ;
          rdfs:label "is Parent"@en .


###  http://coconutKG.aksw.org/ontology#isPlaceholder
:isPlaceholder rdf:type owl:DatatypeProperty ;
               rdfs:domain :Status ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Indicates whether the molecule is a placeholder in the dataset, serving as a temporary or default entry without full attributes."@en ;
               rdfs:label "is Placeholder"@en .


###  http://coconutKG.aksw.org/ontology#isPublic
:isPublic rdf:type owl:DatatypeProperty ;
          rdfs:domain :Collection ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Indicates whether the collection is publicly accessible or private."@en ;
          rdfs:label "Is Public"@en .


###  http://coconutKG.aksw.org/ontology#isTautomer
:isTautomer rdf:type owl:DatatypeProperty ;
            rdfs:domain :Classification ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Indicates whether the molecule is a tautomer, which is a specific type of chemical structure that can easily interconvert with another form."@en ;
            rdfs:label "is Tautomer"@en .


###  http://coconutKG.aksw.org/ontology#iupacName
:iupacName rdf:type owl:DatatypeProperty ;
           rdfs:domain :Identifier ;
           rdfs:range xsd:string ;
           rdfs:comment "The name assigned to the molecule according to the International Union of Pure and Applied Chemistry (IUPAC) nomenclature rules, providing a standardized name for communication."@en ;
           rdfs:label "IUPAC Name"@en .


