<?xml version="1.0"?>
<rdf:RDF xmlns="http://coconutKG.aksw.org/ontology#"
     xml:base="http://coconutKG.aksw.org/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://coconutKG.aksw.org/ontology#">
        <terms:creator>Louis Westerheide</terms:creator>
        <terms:description xml:lang="en">COCONUT[KG] is a knowledge graph based on the Coconut Dataset, which is a comprehensive platform that facilitates natural product research by providing data, tools, and other resources and provides services for the deposition, curation, and reuse of data.</terms:description>
        <terms:rights xml:lang="en"></terms:rights>
        <terms:title xml:lang="en">COCONUT[KG]</terms:title>
        <vann:preferredNamespacePrefix>coco</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://coconutKG.aksw.org/ontology#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">coco: CoconutKG</rdfs:label>
        <owl:versionInfo>SNAPSHOT</owl:versionInfo>
    </owl:Ontology>
    


