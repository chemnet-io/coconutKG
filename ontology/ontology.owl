        <rdfs:comment xml:lang="en"></rdfs:comment>
        <rdfs:label xml:lang="en">defines</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#describedBy -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#describedBy">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Properties"/>
        <rdfs:comment xml:lang="en">A molecule is descriped by its properties.</rdfs:comment>
        <rdfs:label xml:lang="en">describedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#foundIn -->


