    <!-- http://coconutKG.aksw.org/ontology#AlogP -->


    <owl:DatatypeProperty rdf:about="http://coconutKG.aksw.org/ontology#AlogP">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#ElectronicDescriptor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The logarithm of the partition between n-octanol and water (logP). AlogP is used to estimate the lipophilicity of a molecule, which is an important factor in drug absorption and distribution.</rdfs:comment>
        <rdfs:label xml:lang="en">AlogP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#LipinskiRuleOfFiveViolations -->


    <owl:DatatypeProperty rdf:about="http://coconutKG.aksw.org/ontology#LipinskiRuleOfFiveViolations">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#ElectronicDescriptor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">A custom function to determine the number of Lipinski&apos;s rule violations for a given molecule.</rdfs:comment>
        <rdfs:label xml:lang="en">Lipinski Rule Of Five Violations</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#active -->


    <owl:DatatypeProperty rdf:about="http://coconutKG.aksw.org/ontology#active">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Status"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the molecule is currently active or inactive.</rdfs:comment>
        <rdfs:label xml:lang="en">Active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#activeCitation -->


    <owl:DatatypeProperty rdf:about="http://coconutKG.aksw.org/ontology#activeCitation">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Citation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Determines wheater a citation is still active or not.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Citation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#annotationLevel -->


    <owl:DatatypeProperty rdf:about="http://coconutKG.aksw.org/ontology#annotationLevel">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#DescriptiveInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">A numerical value indicating the thoroughness or depth of the annotation provided for the molecule, reflecting its level of detail.</rdfs:comment>
        <rdfs:label xml:lang="en">Annotation Level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#aromaticRingCount -->


    <owl:DatatypeProperty rdf:about="http://coconutKG.aksw.org/ontology#aromaticRingCount">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#TopologicalDescriptor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="en">The number of aromatic rings in a molecule.</rdfs:comment>
        <rdfs:label xml:lang="en">Aromatic Ring Count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#authors -->


    <owl:DatatypeProperty rdf:about="http://coconutKG.aksw.org/ontology#authors">
