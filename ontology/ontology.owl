    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#hasAmounts">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Counts"/>
        <rdfs:comment xml:lang="en">A molecule has certain amounts of different countable properties.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAmounts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#hasStatus -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#hasStatus">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Status"/>
        <rdfs:comment xml:lang="en">A molecule has various statuses.</rdfs:comment>
        <rdfs:label xml:lang="en">hasStatus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#includes -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#includes">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Collection"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:comment xml:lang="en">The collection includes a molecule.</rdfs:comment>
        <rdfs:label xml:lang="en">includes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#isExplainedThrough -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#isExplainedThrough">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#DescriptiveInformation"/>
        <rdfs:comment xml:lang="en">A molecule is explained through its descriptive information.</rdfs:comment>
        <rdfs:label xml:lang="en">isExplainedThrough</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#isRepresentedIn -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#isRepresentedIn">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Collection"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Entry"/>
        <rdfs:comment xml:lang="en">A collection is represented in an entry.</rdfs:comment>
        <rdfs:label xml:lang="en">isRepresentedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#labeledBy -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#labeledBy">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Identifier"/>
        <rdfs:comment xml:lang="en">A molceule is labeled by an Identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">labeledBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#originatesFrom -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#originatesFrom">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Organism"/>
        <rdfs:comment xml:lang="en">The molecule origintes from a certain organism.</rdfs:comment>
        <rdfs:label xml:lang="en">originatesFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#specifiesExtractionLocationOf -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#specifiesExtractionLocationOf">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#SampleLocation"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:comment xml:lang="en">The sample location specifies from where the molecule was extracted from.</rdfs:comment>
        <rdfs:label xml:lang="en">specifiesExtractionLocationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#specifiesLocationOf -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#specifiesLocationOf">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#SampleLocation"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Organism"/>
        <rdfs:comment xml:lang="en">The sample location specifies the location of the organism it originated from.</rdfs:comment>
        <rdfs:label xml:lang="en">specifiesLocationOf</rdfs:label>
    </owl:ObjectProperty>
    


