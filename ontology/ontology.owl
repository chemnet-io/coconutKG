    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://coconutKG.aksw.org/ontology#citedIn -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#citedIn">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Entry"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Citation"/>
        <rdfs:comment xml:lang="en">The entry and its corresponding citation.</rdfs:comment>
        <rdfs:label xml:lang="en">citedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#classifiedBy -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#classifiedBy">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Classification"/>
        <rdfs:comment xml:lang="en">A molecule is classified by its classification.</rdfs:comment>
        <rdfs:label xml:lang="en">classifiedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#contains -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#contains">
        <rdfs:domain rdf:resource="http://coconutKG.aksw.org/ontology#Entry"/>
        <rdfs:range rdf:resource="http://coconutKG.aksw.org/ontology#Molecule"/>
        <rdfs:comment xml:lang="en">An entry contains a given molecule.</rdfs:comment>
        <rdfs:label xml:lang="en">contains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://coconutKG.aksw.org/ontology#defines -->


    <owl:ObjectProperty rdf:about="http://coconutKG.aksw.org/ontology#defines">
